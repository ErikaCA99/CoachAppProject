{
  "expo": {
    "name": "CoachApp",
    "slug": "cocha-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-coachapp.png",
    "scheme": "coachapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo-coachapp.png"
    },
    "android": {
      "package": "com.company.coachapp",
      "adaptiveIcon": {
        "backgroundColor": "#0A141E",
        "foregroundImage": "./assets/images/logo-coachapp.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-coachapp.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/logo-coachapp.png",
          "imageWidth": 120
        }
      ],
      "expo-image",
      "@react-native-google-signin/google-signin",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "CoachApp usa la cámara para identificar las máquinas del gimnasio.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "react-native-fast-tflite",
      "@react-native-firebase/app",
      "@react-native-firebase/app-check"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bfd9da62-489c-4ed1-996a-d6075f4a6cdd"
      }
    }
  }
}
