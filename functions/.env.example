# URL del despliegue dedicado de Ultralytics Platform (pestaña Implementaciones).
# Formato: https://predict-<id>-<hash>-<region>.a.run.app  (se añade /predict).
# La clave NO va aquí: firebase functions:secrets:set ULTRALYTICS_API_KEY
ULTRALYTICS_ENDPOINT_URL=https://

# Parámetros de inferencia (opcionales; rangos del contrato OpenAPI).
# conf 0.01–1: bájalo (p. ej. 0.1) si el escáner casi nunca sugiere máquinas.
ULTRALYTICS_CONF=0.25
ULTRALYTICS_IOU=0.5
ULTRALYTICS_IMGSZ=640
